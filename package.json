{
  "name": "vansathi",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "typecheck:functions": "npm --prefix functions run build",
    "lint": "eslint .",
    "test": "jest --passWithNoTests",
    "test:rules": "NO_UPDATE_NOTIFIER=1 XDG_CONFIG_HOME=./work/xdg-config TMPDIR=./work/tmp FIREBASE_EMULATORS_PATH=./work/firebase-emulators firebase emulators:exec --project demo-vansathi --only firestore,database \"node --test tests/security/rules.mjs\"",
    "check:locales": "node scripts/check-locales.mjs",
    "ci": "npm run check:locales && npm run typecheck && npm run typecheck:functions && npm run lint && npm test && npm run test:rules"
  },
  "jest": {
    "preset": "jest-expo",
    "cacheDirectory": "<rootDir>/work/jest-cache"
  },
  "dependencies": {
    "@expo/config-plugins": "~57.0.10",
    "@maplibre/maplibre-react-native": "^11.5.0",
    "@react-native-firebase/app": "^26.4.0",
    "@react-native-firebase/app-check": "^26.4.0",
    "@react-native-firebase/auth": "^26.4.0",
    "@react-native-firebase/crashlytics": "^26.4.0",
    "@react-native-firebase/database": "^26.4.0",
    "@react-native-firebase/firestore": "^26.4.0",
    "@react-native-firebase/functions": "^26.4.0",
    "@react-native-firebase/messaging": "^26.4.0",
    "@tanstack/react-query": "^5.66.0",
    "expo": "~57.0.0",
    "expo-battery": "~57.0.3",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-intent-launcher": "~57.0.1",
    "expo-localization": "~57.0.2",
    "expo-location": "~57.0.20",
    "expo-network": "~57.0.2",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-sqlite": "~57.0.4",
    "expo-task-manager": "~57.0.21",
    "i18next": "^26.4.3",
    "promise": "^8.3.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.54.2",
    "react-i18next": "^17.0.16",
    "react-native": "0.86.3",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@react-native/jest-preset": "0.86.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "firebase": "^13.0.0",
    "firebase-tools": "^15.33.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "typescript": "~6.0.3"
  }
}
