{
  "rules": {
    ".read": false,
    ".write": false,
    "access": { ".read": false, ".write": false },
    "live": {
      "$vanId": {
        ".read": "auth != null && ((root.child('access/parents').child(auth.uid).child($vanId).val() === true && data.child('tripActive').val() === true) || root.child('access/drivers').child(auth.uid).child($vanId).val() === true)",
        ".write": "auth != null && root.child('access/drivers').child(auth.uid).child($vanId).val() === true && root.child('access/activeTrips').child($vanId).val() === true",
        ".validate": "newData.hasChildren(['lat', 'lng', 'speed', 'heading', 'accuracy', 'timestamp', 'tripId', 'batteryLevel', 'tripActive'])",
        "lat": { ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90" },
        "lng": { ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180" },
        "speed": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 33.33" },
        "heading": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 360" },
        "accuracy": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 50" },
        "timestamp": { ".validate": "newData.isNumber() && newData.val() <= now && newData.val() > now - 60000" },
        "tripId": { ".validate": "newData.isString() && newData.val().length <= 128" },
        "batteryLevel": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
        "tripActive": { ".validate": "newData.isBoolean()" },
        "$other": { ".validate": false }
      }
    }
  }
}
